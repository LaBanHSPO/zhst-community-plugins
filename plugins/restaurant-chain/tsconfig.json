{
	"extends": "astro/tsconfigs/strict",
	"include": ["src", "tests"],
	"exclude": ["dist", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["node", "@cloudflare/workers-types"],
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true
	}
}
